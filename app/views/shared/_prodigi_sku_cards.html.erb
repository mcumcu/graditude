<% variant_groups = local_assigns.fetch(:variant_groups, []) %>
<% form_id = local_assigns[:form_id] %>
<% cart_product_ids = local_assigns.fetch(:cart_product_ids, []) %>
<% cart_items_by_product_id = local_assigns.fetch(:cart_items_by_product_id, {}) %>
<% cart_items_count = local_assigns.fetch(:cart_items_count, 0) %>

<div class="space-y-6" data-controller="variant-picker" data-action="clear-variant-selection->variant-picker#clearFields">
  <%= hidden_field_tag :prodigi_catalog_item_id, nil, data: { variant_picker_target: "selectedItemId" } %>
  <%= hidden_field_tag :stripe_price_id, nil, data: { variant_picker_target: "selectedPriceId" } %>
  <%= hidden_field_tag :product_id, nil, data: { variant_picker_target: "selectedProductId" } %>

  <% variant_groups.each do |sku_group| %>
    <div class="rounded-3xl border border-primary/10 bg-background-secondary p-5 shadow-sm">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-content-muted">SKU</p>
          <h3 class="mt-2 text-2xl font-semibold text-primary"><%= sku_group.label %></h3>
          <% if sku_group.description.present? %>
            <p class="mt-3 max-w-2xl text-sm text-content-muted"><%= sku_group.description %></p>
          <% end %>
        </div>

        <div class="rounded-2xl border border-primary/10 bg-background p-4 text-right">
          <p class="text-sm text-content-muted">From</p>
          <p class="mt-1 text-xl font-semibold text-primary"><%= formatted_prodigi_price(sku_group.min_price_cents, sku_group.currency) %></p>
        </div>
      </div>

      <div class="mt-6 space-y-4">
        <% sku_group.frame_variants.each_with_index do |variant, index| %>
          <%= render "shared/prodigi_frame_variant_card", variant: variant, sku_group: sku_group, form_id: form_id, cart_product_ids: cart_product_ids, cart_items_by_product_id: cart_items_by_product_id, cart_items_count: cart_items_count, index: index %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
